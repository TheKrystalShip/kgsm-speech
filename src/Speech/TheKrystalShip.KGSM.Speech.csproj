<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Hand-rolled binary framing over a unix socket: no reflection and no serializer, so this is
         safe to embed in a Native-AOT consumer as well as in the JIT ones. -->
    <IsAotCompatible>true</IsAotCompatible>

    <RootNamespace>TheKrystalShip.KGSM.Speech</RootNamespace>
    <AssemblyName>TheKrystalShip.KGSM.Speech</AssemblyName>

    <!-- The shared wire contract for the kgsm-speech daemon, and the client that speaks it. Built
         here (the daemon owns the shape) and consumed by every surface that wants a voice — kgsm-bot
         today, the assistant next — so a contract break is a compile break rather than a socket that
         goes quiet. -->
    <PackageId>TheKrystalShip.KGSM.Speech</PackageId>
    <!-- Bump on ANY change to the framing or the message set; NuGet caches by id+version, so a
         same-version repack serves a stale dll to a consumer. -->
    <Version>1.4.0</Version>
    <Authors>Heisenberg</Authors>
    <Description>Client and wire contract for the kgsm-speech daemon: speech recognition and synthesis over a unix socket, shared by every KGSM surface that listens or speaks.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TheKrystalShip/KGSM-Speech</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheKrystalShip/KGSM-Speech</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KGSM.Speech.Tests" />
    <InternalsVisibleTo Include="kgsm-speech" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
