# kgsm-speech — operator overrides. Seeded once by deploy/setup.sh into
# /etc/kgsm-speech/kgsm-speech.env and never touched again, so what you set here survives every
# deploy.
#
# Everything in kgsm-speech.settings.json can be overridden here in Section__Key form. There are no
# secrets: this daemon holds no credential, reaches no network, and authenticates nobody — the
# socket's filesystem permissions are its whole access boundary.
#
# The Control Panel writes its own overrides to /var/lib/kgsm-api/leaf-overrides/speech.env, which
# the unit loads AFTER this file. So a value set there beats a value set here.

# The voice every surface on this host speaks in. `kgsm-speech --voices` lists what is installed.
#Speech__Voice=af_heart

# How long to stay loaded with nothing to say. 0 stays loaded until the host restarts. Ending the
# process is the only thing that gives back the ~1.6GB and the ~1.1GB of video memory the models
# cost; the price of unloading is a few seconds when somebody next speaks.
#Speech__IdleMinutes=0

# The card. Both default to true and fall back to the processor on a host without a usable GPU —
# recognition is ~40x slower there and synthesis ~8x, but neither refuses.
#Speech__UseGpu=true
#Speech__SpeakUseGpu=true

# The models. Defaults live in /var/lib/kgsm-speech/models, which deploy/setup.sh provisions.
#Speech__ModelPath=/var/lib/kgsm-speech/models/ggml-small.en.bin
#Speech__SpeechModelPath=/var/lib/kgsm-speech/models/kokoro.onnx

# How much this daemon says about itself. Debug reports every utterance's duration and every
# synthesis, which is how you tell a slow card from a slow model.
#Logging__LogLevel__Default=Information
